Options -Indexes
DirectoryIndex index.php

# LICENSE et CHANGELOG : servis en text/plain pour conformité AGPL.
<Files "LICENSE">
    ForceType text/plain
</Files>
<Files "CHANGELOG.md">
    ForceType text/plain
</Files>
<Files "README.md">
    ForceType text/plain
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloque l'accès direct aux dossiers internes et fichiers sensibles.
    RewriteRule ^(data|lib|templates|controllers|services)(/|$) - [F,L]
    RewriteRule ^(config\.php|config\.php\.example|routes\.php|seed[a-z_]*\.php|migrate_from_frama[a-z_]*\.php|\.gitignore)$ - [F,L]
    RewriteRule \.(sqlite|sqlite-journal|sqlite-wal|sqlite-shm|log)$ - [F,L]

    # Si le fichier existe sur disque (ex: public/style.css), sert tel quel.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Sinon, route vers le front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>
